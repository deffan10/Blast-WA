# Server Configuration
PORT=3000
NODE_ENV=development
# Timezone untuk jam kirim & reset harian (contoh: Asia/Jakarta). Kosong = waktu server.
# APP_TIMEZONE=Asia/Jakarta

# Database Configuration (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=blast_wa
DB_USER=root
DB_PASSWORD=

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=24h

# Redis Configuration (for Bull Queue)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# WhatsApp Configuration
WA_SESSION_PATH=./wa_sessions
# Batas pesan: true = 100 per akun WA (disarankan), false = 100 total dibagi ke semua akun
LIMIT_PER_ACCOUNT=true
MAX_MESSAGES_PER_DAY=100
# Delay antar pesan (anti-ban): minimal 5-15 menit + random 30-90 detik
MIN_DELAY_SECONDS=300
MAX_DELAY_SECONDS=900
RANDOM_DELAY_MIN=30
RANDOM_DELAY_MAX=90
# Jeda antar campaign saat multi campaign (detik). Default 30
DELAY_BETWEEN_CAMPAIGNS_SECONDS=30
# Jam kirim (0-23, pakai waktu server). Kosongkan = tidak dibatasi. Contoh: stop kirim setelah jam 22.
# SEND_HOUR_START=8
SEND_HOUR_END=22
# Tips: Jaga HP tetap online & WhatsApp terbuka; jangan buka WA Web di browser lain (conflict)

# Admin Default Credentials (change after first login)
ADMIN_EMAIL=admin@blasta.com
ADMIN_PASSWORD=admin123
